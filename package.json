{
  "name": "johnny-five-companion",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:lan": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "five-v2:assets:slice": "node scripts/five-v2-assets/slice-puppet-sheet.ts",
    "five-v2:assets:validate": "node scripts/five-v2-assets/validate-assets.ts",
    "five-v2:check-legacy": "node scripts/five-v2-assets/check-no-legacy-five-assets.ts",
    "five-v2:check": "npm run five-v2:assets:validate && npm run five-v2:check-legacy",
    "check:five-v2": "npm run five-v2:check"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.184.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "pngjs": "^7.0.0"
  }
}
